<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@android:color/white">

    <!-- Top Header: Title & Heart -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="တို့နှစ်ယောက် ချစ်သက်တမ်း"
            android:textColor="#FF6B8B"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="❤️"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Center: Milestone Days Counter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/widget_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="139"
            android:textColor="#FF4B72"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="ရက်မြောက်"
            android:textColor="#FF6B8B"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Partner Live Screen Display Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#FFF5F7"
        android:padding="6dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💌 Partner Live Screen"
            android:textColor="#A0AEC0"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginBottom="2dp" />

        <!-- Live Message Text Display -->
        <TextView
            android:id="@+id/widget_live_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="MY LOVE"
            android:textColor="#2D3748"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="2" />

        <!-- Live Drawing Image Display -->
        <ImageView
            android:id="@+id/widget_live_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
