<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Semi-Transparent Dark Glass (ဖုန်း Wallpaper ဖောက်မြင်ရမည့် အကြည်ရောင် ၄၀%) -->
    <solid android:color="#5914101e" />
    <!-- Neon Pink Glow Border (အနားကွပ် ပန်းရောင်လိုင်း) -->
    <stroke
        android:width="1.5dp"
        android:color="#66ff4b8b" />
    <corners android:radius="22dp" />
</shape>
